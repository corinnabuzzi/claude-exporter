  "dependencies": {
    "@claude-exporter/core": "0.1.0",
    "@claude-exporter/protocol": "0.1.0",
    "ink": "8.0.0",
    "react": "19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/ws": "8.18.2",
    "ink-testing-library": "4.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
